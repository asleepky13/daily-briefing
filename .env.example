# Copy to .env for local runs. On GitHub, add these as repository secrets instead.
# Every integration is OFF until you enable it in config.yaml.

# Google Sheets logging (integrations.google_sheets)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Email digest (integrations.email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Slack or Discord incoming webhook URL (integrations.webhook)
WEBHOOK_URL=

# ntfy.sh topic name; pick something long and unguessable (integrations.ntfy)
NTFY_TOPIC=
